{
  "entities": {
    "Program": {
      "title": "Program",
      "description": "Skautský výchovný program nebo hra",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "summary": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 10000 },
        "educationalGoals": { "type": "string", "maxLength": 2000 },
        "materials": { "type": "string", "maxLength": 2000 },
        "durationMinutes": { "type": "number" },
        "ageCategories": { "type": "array" },
        "scoutMethods": { "type": "array" },
        "physicalDemand": { "type": "number" },
        "intellectualDemand": { "type": "number" },
        "creativity": { "type": "number" },
        "teamwork": { "type": "number" },
        "preparationDemand": { "type": "number" },
        "environment": { "type": "string", "enum": ["inside", "outside", "both"] },
        "weather": { "type": "array" },
        "tags": { "type": "array" },
        "attachmentUrl": { "type": "string", "maxLength": 1000 },
        "attachmentName": { "type": "string", "maxLength": 200 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "ratingAverage": { "type": "number" },
        "ratingCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "summary", "description", "durationMinutes", "authorId", "authorName"]
    },
    "Review": {
      "title": "Review",
      "description": "Hodnocení a komentář k programu",
      "type": "object",
      "properties": {
        "programId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string" }
      },
      "required": ["programId", "userId", "userName", "rating", "comment"]
    },
    "Favorite": {
      "title": "Favorite",
      "description": "Uložený oblíbený program uživatele",
      "type": "object",
      "properties": {
        "programId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["programId", "userId"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Uživatelský profil skauta",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 100 },
        "unitName": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "displayName"]
    }
  },
  "firestore": {
    "/programs/{programId}": {
      "schema": "Program",
      "description": "Kolekce všech sdílených skautských programů"
    },
    "/programs/{programId}/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Komentáře a hodnocení pro daný program"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Základní profil uživatele"
    },
    "/users/{userId}/favorites/{favoriteId}": {
      "schema": "Favorite",
      "description": "Oblíbené programy uživatele"
    }
  }
}
